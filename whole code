int nameToIndex(Graph *m, const char *name) {
    int result = -1;
    int i = 0;
    while (i < V && result == -1) {
        if (strcmp(m->names[i], name) == 0) {
            result = i;
        }
        i++;
    }
    return result;
}

void setVertexNames(Graph *m, const char *vertexNames[V]) {
	int i;
    for (i = 0; i < V; i++)
        strncpy(m->names[i], vertexNames[i], NAME_LEN - 1);
}

void buildGraph(Graph *m, const char *edgeNames[][2], int weights[], int edgeCount) {
	int i, j, f, t, w;
    for (i = 0; i < V; i++)
        for (j = 0; j < V; j++)
            m->adj[i][j] = 0;

    for (i = 0; i < edgeCount; i++) {
        f = nameToIndex(m, edgeNames[i][0]);
        t = nameToIndex(m, edgeNames[i][1]);
        w = weights[i];

        if (f == -1 || t == -1) {
            printf("Warning: unknown vertex name in edge %d ('%s' or '%s')\n",
                   i, edgeNames[i][0], edgeNames[i][1]);
        } else {
            m->adj[f][t] = w;               
        }
    }
}


void dijkstra(Graph *m, int src) {
    int visited[V];
    int count = 0, done = 0, min;
    int i, v, u;
    for (i = 0; i < V; i++) {
        m->dist[src][i] = INT_MAX;
        visited[i] = 0;
        m->prevV[src][i] = -1;
    }
    m->dist[src][src] = 0;

    
    while (count < V - 1 && !done) {
        u = -1, min = INT_MAX;
        for (v = 0; v < V; v++)
            if (!visited[v] && m->dist[src][v] <= min) {
                min = m->dist[src][v];
                u = v;
            }

        if (u == -1) {
            done = 1;
        } else {
            visited[u] = 1;
            for (v = 0; v < V; v++) {
                if (!visited[v] && m->adj[u][v] && m->dist[src][u] != INT_MAX
                    && m->dist[src][u] + m->adj[u][v] < m->dist[src][v]) {
                    m->dist[src][v] = m->dist[src][u] + m->adj[u][v];
                    m->prevV[src][v] = u;
                }
            }
        }
        count++;
    }
}

void computeAllPairs(Graph *m) {
	int i;
    for (i = 0; i < V; i++)
        dijkstra(m, i);
}

void printPath(Graph *m, int src, int dest) {
	int i;
    int path[V];
    int at,  count = 0;
    if (dest == src) {
        printf("%s", m->names[src]);
    } else if (m->prevV[src][dest] == -1) {
        printf("NO PATH");
    } else {
		at = dest;
        while (at != -1) {
            path[count++] = at;
            at = (at == src) ? -1 : m->prevV[src][at];
        }
        for (i = count - 1; i >= 0; i--) {
            printf("%s", m->names[path[i]]);
            if (i != 0) printf(" -> ");
        }
    }
}

void followUserRoute(Graph *m, int stops[], int n, int src, RouteResult *result) {
    int i;
    int current = src;
    int total = 0;
    int unreachable = 0;
    int legDist;

    for (i = 0; i < n; i++) {
        result->order[i] = stops[i];

        if (!unreachable) {
            legDist = m->dist[current][stops[i]];
            if (legDist == INT_MAX) {
                unreachable = 1;
            } else {
                total += legDist;
            }
        }

        current = stops[i];
    }

    if (unreachable) {
        result->total = INT_MAX;
    } else {
        result->total = total;
    }
}

