int initGraphData(const char *filename, const char *vertexNames[V], const char *edgeNames[E][2], int weights[E]) { //gets all graph data in the text file and puts it in graph struct
    static char vNameBuf[V][NAME_LEN];
    static char eNameBuf[E][2][NAME_LEN];
    FILE *fp;
    int fileV, fileE;
    int i;
    int ok = 1;
 
    fp = fopen(filename, "r");
    if (fp == NULL) {
        printf("Error: could not open graph data file '%s'\n", filename);
        ok = 0;
    }
 
    if (ok && (fscanf(fp, "%d", &fileV) != 1 || fileV != V)) {
        printf("Error: file '%s' expected %d vertices, found %d\n", filename, V, fileV);
        ok = 0;
    }
 
    for (i = 0; ok && i < V; i++) {
        if (fscanf(fp, " %31[^\n]", vNameBuf[i]) != 1) {
            printf("Error: failed reading vertex name %d from '%s'\n", i, filename);
            ok = 0;
        } else {
            vertexNames[i] = vNameBuf[i];
        }
    }
 
    if (ok && (fscanf(fp, "%d", &fileE) != 1 || fileE != E)) {
        printf("Error: file '%s' expected %d edges, found %d\n", filename, E, fileE);
        ok = 0;
    }
 
    for (i = 0; ok && i < E; i++) {
        if (fscanf(fp, " %31[^|]|%31[^|]|%d", eNameBuf[i][0], eNameBuf[i][1], &weights[i]) != 3) {
            printf("Error: failed reading edge %d from '%s'\n", i, filename);
            ok = 0;
        } else {
            edgeNames[i][0] = eNameBuf[i][0];
            edgeNames[i][1] = eNameBuf[i][1];
        }
    }
 
    if (fp != NULL) {
        fclose(fp);
    }
 
    return ok;
}

int nameToIndex(Graph *m, const char *name) { //returns the index of the name
    int result = -1;
    int i = 0;
    while (i < V && result == -1) {
        if (strcmp(m->names[i], name) == 0) {
            result = i;
        }
        i++;
    }
    return result;
}

void setVertexNames(Graph *m, const char *vertexNames[V]) { 
	int i;
    for (i = 0; i < V; i++)
        strncpy(m->names[i], vertexNames[i], NAME_LEN - 1);
}

void buildGraph(Graph *m, const char *edgeNames[][2], int weights[], int edgeCount) { //"builds" the graph in Graph struct
	int i, j, f, t, w;
    for (i = 0; i < V; i++)
        for (j = 0; j < V; j++)
            m->adj[i][j] = 0;

    for (i = 0; i < edgeCount; i++) {
        f = nameToIndex(m, edgeNames[i][0]);
        t = nameToIndex(m, edgeNames[i][1]);
        w = weights[i];

        if (f == -1 || t == -1) {
            printf("Warning: unknown vertex name in edge %d ('%s' or '%s')\n",
                   i, edgeNames[i][0], edgeNames[i][1]);
        } else {
            m->adj[f][t] = w;               
        }
    }
}
